{
  "name": "PDF Optimizer - Internet Archive",
  "build": {"dockerfile": "../Dockerfile", "context": ".."},
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {"label": "PDF Optimizer (accesso privato)", "visibility": "private", "onAutoForward": "openBrowser"}
  },
  "postStartCommand": "bash -lc 'nohup python /opt/pdf-optimizer/server.py >/tmp/pdf-optimizer-server.log 2>&1 </dev/null &'",
  "remoteUser": "root"
}
